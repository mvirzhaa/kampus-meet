{
  "name": "kampus-meet",
  "version": "1.0.0",
  "private": true,
  "description": "Aplikasi video conference kampus (SFU LiveKit + Node.js tanpa dependensi runtime)",
  "type": "module",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "start": "node --disable-warning=ExperimentalWarning --env-file-if-exists=.env server/index.js",
    "dev": "node --disable-warning=ExperimentalWarning --env-file-if-exists=.env --watch server/index.js"
  },
  "devDependencies": {
    "@fontsource-variable/plus-jakarta-sans": "^5.2.8",
    "@livekit/track-processors": "^0.8.2",
    "adhan": "^4.4.3",
    "esbuild": "^0.28.2",
    "jspdf": "^4.2.1",
    "jspdf-autotable": "^5.0.9",
    "livekit-client": "^2.23.0",
    "lucide": "^1.61.0",
    "pdfjs-dist": "^4.10.38",
    "qrcode-generator": "^2.0.4"
  }
}
