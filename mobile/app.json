{
  "expo": {
    "name": "UIKA Meet",
    "slug": "uika-meet",
    "scheme": "uikameet",
    "version": "1.0.0",
    "orientation": "default",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "backgroundColor": "#F1F7F4",
    "primaryColor": "#047857",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "id.ac.uikabogor.meet",
      "infoPlist": {
        "NSCameraUsageDescription": "Kamera dipakai untuk menampilkan video Anda di meeting.",
        "NSMicrophoneUsageDescription": "Mikrofon dipakai untuk berbicara di meeting dan untuk transkripsi."
      }
    },
    "android": {
      "package": "id.ac.uikabogor.meet",
      "versionCode": 1,
      "adaptiveIcon": {
        "backgroundColor": "#047857",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO",
        "android.permission.MODIFY_AUDIO_SETTINGS",
        "android.permission.BLUETOOTH_CONNECT",
        "android.permission.ACCESS_NETWORK_STATE",
        "android.permission.WAKE_LOCK",
        "android.permission.POST_NOTIFICATIONS",
        "android.permission.SCHEDULE_EXACT_ALARM",
        "android.permission.RECEIVE_BOOT_COMPLETED"
      ],
      "intentFilters": [
        {
          "action": "VIEW",
          "data": [
            {
              "scheme": "https",
              "host": "meet.uika-bogor.ac.id",
              "pathPrefix": "/j/"
            },
            {
              "scheme": "https",
              "host": "meet.uika-bogor.ac.id",
              "pathPrefix": "/r/"
            }
          ],
          "category": [
            "BROWSABLE",
            "DEFAULT"
          ]
        }
      ]
    },
    "extra": {
      "defaultServer": "https://meet.uika-bogor.ac.id"
    },
    "plugins": [
      "expo-router",
      [
        "expo-font",
        {
          "fonts": [
            "./node_modules/@expo-google-fonts/plus-jakarta-sans/400Regular/PlusJakartaSans_400Regular.ttf",
            "./node_modules/@expo-google-fonts/plus-jakarta-sans/600SemiBold/PlusJakartaSans_600SemiBold.ttf",
            "./node_modules/@expo-google-fonts/plus-jakarta-sans/700Bold/PlusJakartaSans_700Bold.ttf",
            "./node_modules/@expo-google-fonts/plus-jakarta-sans/800ExtraBold/PlusJakartaSans_800ExtraBold.ttf"
          ]
        }
      ],
      "expo-secure-store",
      [
        "expo-build-properties",
        {
          "android": {
            "minSdkVersion": 26,
            "enableMinifyInReleaseBuilds": false,
            "extraProguardRules": "-keep class org.webrtc.** { *; }\n-keep class com.livekit.** { *; }\n-keep class com.google.mlkit.** { *; }"
          }
        }
      ],
      [
        "expo-speech-recognition",
        {
          "microphonePermission": "Mikrofon dipakai untuk berbicara di meeting dan untuk transkripsi.",
          "speechRecognitionPermission": "Pengenal suara dipakai untuk membuat transkrip & terjemahan meeting.",
          "androidSpeechServicePackages": [
            "com.google.android.googlequicksearchbox",
            "com.google.android.tts",
            "com.google.android.as"
          ]
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 160,
          "resizeMode": "contain",
          "backgroundColor": "#022C22"
        }
      ],
      "expo-audio",
      [
        "expo-notifications",
        {
          "icon": "./assets/notification-icon.png",
          "color": "#047857",
          "sounds": [
            "./assets/sounds/azan_takbir.wav"
          ]
        }
      ],
      [
        "@livekit/react-native-expo-plugin",
        {
          "android": {
            "audioType": "communication"
          }
        }
      ],
      "@config-plugins/react-native-webrtc"
    ],
    "experiments": {
      "typedRoutes": false
    },
    "web": {
      "output": "single",
      "bundler": "metro",
      "favicon": "./assets/icon.png"
    }
  }
}