# ===== Aplikasi =====
NODE_ENV=production
PORT=3000
HOST=0.0.0.0
PUBLIC_URL=https://meet.uika-bogor.ac.id
# true bila di belakang reverse proxy (Caddy/Nginx) agar IP klien terbaca benar untuk rate limit
TRUST_PROXY=true

APP_NAME=UIKA Meet
CAMPUS_NAME=Universitas Ibn Khaldun Bogor
# Batasi pendaftaran ke domain email kampus (pisahkan dengan koma). Kosongkan = semua domain.
ALLOWED_EMAIL_DOMAINS=uika-bogor.ac.id
ALLOW_REGISTRATION=true
# Super-admin tetap: akun dengan email ini selalu berperan admin dan tidak bisa diturunkan
# atau dinonaktifkan lewat Panel Admin. Kosongkan = hanya pendaftar pertama yang jadi admin.
ADMIN_EMAIL=
MAX_UPLOAD_MB=30
MAX_PARTICIPANTS=300
SESSION_DAYS=7
APP_TIMEZONE=Asia/Jakarta
# Sertifikat hanya untuk peserta dengan durasi (masuk pertama → keluar terakhir) minimal N menit
CERT_MIN_MINUTES=15
# Transkrip otomatis dihapus setelah N hari (0 = simpan selamanya)
TRANSCRIPT_RETENTION_DAYS=180
DATA_DIR=data

# Rahasia tambahan untuk enkripsi password room (min. 32 karakter acak)
APP_SECRET=ganti_dengan_string_acak_panjang

# ===== Perekaman =====
# egress = direkam di server (MP4 H.264 720p) lalu otomatis diunggah ke Google Drive; local = di browser moderator; off = nonaktif
RECORDING_MODE=egress
REC_WIDTH=1280
REC_HEIGHT=720
REC_FPS=15
REC_VIDEO_KBPS=800
REC_AUDIO_KBPS=64
# Hapus file MP4 lokal yang gagal diunggah setelah N hari
REC_KEEP_FAILED_DAYS=7

# ===== Google Drive (tujuan rekaman) =====
# Buat OAuth Client (Web application) di console.cloud.google.com, aktifkan Google Drive API,
# daftarkan Redirect URI: https://<domain aplikasi>/api/admin/gdrive/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# ID folder dari link https://drive.google.com/drive/folders/<ID>
GDRIVE_FOLDER_ID=1TrZSxJcl848o97ilhWajKHhpyrEiFt35

# Kata sandi Redis internal (dibuat otomatis oleh scripts/gen-env.sh)
REDIS_PASSWORD=ganti_dengan_string_acak

# ===== SSO E-Portal UIKA (opsional) =====
# Kosongkan untuk mematikan SSO; aplikasi tetap berjalan penuh dengan login lokal.
# Alur login HANYA dimulai dari dasbor E-Portal (pengguna klik modul "Meet" di sana).
# Daftarkan callback https://<domain aplikasi>/sso/callback ke admin E-Portal.
SSO_BASE_URL=https://eportal.uika-bogor.ac.id/eportal-api
SSO_CLIENT_ID=
SSO_CLIENT_SECRET=
SSO_APP_MODULE_ID=19

# ===== LiveKit (server media SFU) =====
LIVEKIT_URL=http://127.0.0.1:7880
LIVEKIT_PUBLIC_URL=wss://media.meet.uika-bogor.ac.id
LIVEKIT_API_KEY=kampusmeet
# IP publik yang DIHUBUNGI browser (dipakai LiveKit sebagai kandidat ICE).
# Diisi otomatis oleh gen-env.sh dari record A domain aplikasi. Pada server di belakang
# NAT, IP masuk sering berbeda dengan IP keluar — isi manual bila deteksi otomatis salah.
NODE_IP=
LIVEKIT_API_SECRET=ganti_dengan_string_acak_minimal_32_karakter

# Opsional: host sendiri model latar virtual (unduh dengan scripts/fetch-model.sh)
# SEGMENTER_MODEL_URL=/vendor/mediapipe/selfie_segmenter.tflite

# Opsional: cadangan terjemahan transkrip (Indonesia <-> Inggris) untuk peserta yang browsernya
# tidak punya penerjemah bawaan (HP, Firefox, Safari). Chrome/Edge desktop menerjemahkan di
# perangkat tanpa server. Aktifkan layanan:  docker compose --profile translate up -d
# TRANSLATE_URL=http://127.0.0.1:5000
# TRANSLATE_API_KEY=
